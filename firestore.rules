rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configurações do Casamento (Público lê, admin escreve)
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Lista de Convidados Master (Público não lê/escreve, admin gerencia)
    match /guestlist/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // RSVPs (Público cria/lê, admin gerencia)
    match /rsvps/{document} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Presentes (Público lê e reserva, admin gerencia)
    match /gifts/{document} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Padrinhos (Público lê/cria, admin gerencia)
    match /godparents/{document} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // PIX (Público lê/cria, admin gerencia)
    match /pix/{document} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
